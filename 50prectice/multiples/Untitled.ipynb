    "num=int(input(\"enter a num\"))\n",
    "length=int(input(\"enter a length\"))\n",
    "def multiples(num,length):\n",
    "    list=[]\n",
    "    print(\"num is : \",num)\n",
    "    print(\"length is : \",length)\n",
    "    for i in range(length+1):\n",
    "        x=num*i\n",
    "        list.append(x)\n",
    "    print(list)\n",
    "multiples(num,length)"
   ]
  }
