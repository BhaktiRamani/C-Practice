   "source": [
    "user_input=int(input())\n",
    "def curzon(user_input):\n",
    "    x=2**user_input+1\n",
    "    y=2*user_input+1\n",
    "    if x%y==0:\n",
    "        print(\"is curzon\")\n",
    "        return True\n",
    "    else:\n",
    "        print(\"is  not curzon\")\n",
    "        return False\n",
    "\n",
    "curzon(user_input)"
   ]
  }
